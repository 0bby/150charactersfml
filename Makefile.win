# Cross-compile to Windows .exe using mingw-w64
#
# Linux Setup (Cross-compiling):
#   1. Install mingw:  sudo pacman -S mingw-w64-gcc
#   2. Download Windows raylib 5.5 from:
#      https://github.com/raysan5/raylib/releases/tag/5.5  (raylib-5.5_win64_mingw-w64.zip)
#   3. Extract to deps/raylib-win/ so you have:
#        deps/raylib-win/lib/libraylib.a
#        deps/raylib-win/include/raylib.h
#   4. Run:  make -f Makefile.win
#
# Local Windows Build (using w64devkit):
#   1. Ensure w64devkit is in your path (e.g., $env:PATH = "C:\raylib\w64devkit\bin;" + $env:PATH)
#   2. Setup deps/raylib-win/ with raylib.h, raymath.h, rlgl.h, and libraylib.a:
#        mkdir -p deps/raylib-win/include; mkdir -p deps/raylib-win/lib
#        cp C:\raylib\raylib\src\raylib.h deps/raylib-win/include/
#        cp C:\raylib\raylib\src\raymath.h deps/raylib-win/include/
#        cp C:\raylib\raylib\src\rlgl.h deps/raylib-win/include/
#        cp C:\raylib\raylib\src\libraylib.a deps/raylib-win/lib/
#   3. Compile:  make -f Makefile.win
#   4. Run:      cd raylib; .\game.exe

CC = x86_64-w64-mingw32-gcc
CFLAGS = -Wall -Wextra -O2

GAME_DIR = raylib
RAYLIB_WIN = deps/raylib-win

GAME_SRCS = $(filter-out $(GAME_DIR)/screenpicker.c, $(wildcard $(GAME_DIR)/*.c)) server/game_session.c
GAME_HDRS = $(wildcard $(GAME_DIR)/*.h) server/game_session.h
GAME_TARGET = $(GAME_DIR)/game.exe

GAME_CFLAGS = $(CFLAGS) -I$(GAME_DIR) -Iserver -I$(RAYLIB_WIN)/include
GAME_LDFLAGS = -L$(RAYLIB_WIN)/lib -lraylib -lopengl32 -lgdi32 -lwinmm -lws2_32 -lm -lpthread -static

# --- Optional EOS P2P relay (build with: make -f Makefile.win USE_EOS=1) ---
ifdef USE_EOS
  EOS_SDK = deps/eos-sdk
  GAME_CFLAGS += -DUSE_EOS -I$(EOS_SDK)/include
  # Remove blanket -static; instead use selective static/dynamic linking
  # so EOS loads dynamically but C runtime + winpthread stay static
  GAME_LDFLAGS := $(filter-out -static,$(GAME_LDFLAGS))
  GAME_LDFLAGS += -Wl,-Bstatic -lpthread -lstdc++ -lwinpthread -Wl,-Bdynamic
  EOS_LDFLAGS = -L$(EOS_SDK)/Lib -lEOSSDK-Win64-Shipping
endif

.PHONY: all clean

all: $(GAME_TARGET)
ifdef USE_EOS
	@cp $(EOS_SDK)/Bin/EOSSDK-Win64-Shipping.dll $(GAME_DIR)/
endif
	@echo "Built: $(GAME_TARGET)"

$(GAME_TARGET): $(GAME_SRCS) $(GAME_HDRS)
	$(CC) $(GAME_CFLAGS) -o $@ $(GAME_SRCS) $(GAME_LDFLAGS) $(EOS_LDFLAGS)

clean:
	rm -f $(GAME_TARGET)
